---
import { LayoutDashboard, Radar, ScanSearch, ClipboardList, ChartNoAxesCombined, MapPin, Search, ArrowRight, ArrowLeft, Camera, Check, Store, Building2, CircleHelp, Route, ChevronDown, SlidersHorizontal, Plus, Eye, X, Menu, RefreshCw } from 'lucide-static';
import '../../styles/workspace.css';

const ico = (svg: string) => svg.replace('class="lucide ', 'aria-hidden="true" class="icon lucide ');
const zones = [
  { id:'hermelinda', name:'La Hermelinda', district:'Trujillo', priority:84, commerce:88, coverage:39, visits:3, x:28, y:29, color:'high', reason:'Alta concentración comercial y menor cobertura relativa de puntos de atención.' },
  { id:'porvenir', name:'El Porvenir', district:'El Porvenir', priority:77, commerce:82, coverage:48, visits:2, x:69, y:34, color:'high', reason:'Diversidad de actividad comercial y cobertura por explorar.' },
  { id:'esperanza', name:'La Esperanza', district:'La Esperanza', priority:68, commerce:73, coverage:54, visits:5, x:39, y:69, color:'medium', reason:'Actividad comercial sostenida con prospección previa limitada.' },
  { id:'mora', name:'Florencia de Mora', district:'Florencia de Mora', priority:61, commerce:64, coverage:57, visits:4, x:76, y:72, color:'medium', reason:'Concentración de pequeños negocios en corredores locales.' },
];
---
<html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="RadarMYPE AI: radar territorial, descubrimiento en campo y seguimiento comercial."/><title>RadarMYPE AI · Espacio comercial</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head>
<body>
<aside class="sidebar" id="sidebar"><a class="brand" href="/prototipo/"><span class="brand-symbol" set:html={ico(Radar)}></span><span><strong>RadarMYPE AI</strong><small>Espacio comercial · Trujillo</small></span></a><div class="side-caption">EXPLORACIÓN</div><nav aria-label="Módulos"><button class="nav active" data-view="overview"><span set:html={ico(LayoutDashboard)}></span>Resumen</button><button class="nav" data-view="radar"><span set:html={ico(Radar)}></span>Radar territorial</button><button class="nav" data-view="scanner"><span set:html={ico(ScanSearch)}></span>Escáner de campo</button><div class="side-caption second">GESTIÓN</div><button class="nav" data-view="log"><span set:html={ico(ClipboardList)}></span>Bitácora de visitas</button><button class="nav" data-view="supervisor"><span set:html={ico(ChartNoAxesCombined)}></span>Vista supervisor</button></nav><div class="side-footer"><a href="/" class="back-link"><span set:html={ico(ArrowLeft)}></span>Volver a la propuesta</a></div></aside>
<div class="workspace"><header class="topbar"><button class="mobile-menu icon-button" id="menu-button" aria-label="Abrir menú"><span set:html={ico(Menu)}></span></button><div class="search-shell"><span set:html={ico(Radar)}></span><span>RadarMYPE AI / Trujillo</span></div><div class="top-right"><span class="workspace-name"><span class="company-dot"></span> Caja Trujillo · Comercial</span></div></header><main class="content">
<section class="view active" id="overview"><div class="page-heading"><div><p class="breadcrumb">Comercial / Resumen</p><h1>Buen día, equipo DEVMINDS</h1><p>Explora microzonas, registra hallazgos de campo y revisa la cobertura comercial.</p></div><button class="primary" data-go="radar"><span set:html={ico(Radar)}></span>Explorar radar</button></div><div class="metric-grid"><article class="metric"><span>Microzonas en exploración</span><strong>04</strong><small>Provincia de Trujillo</small></article><article class="metric"><span>Visitas registradas</span><strong id="visits-count">0</strong><small>En este espacio de trabajo</small></article><article class="metric"><span>Zonas por revisar</span><strong>02</strong><small>Prioridad territorial alta</small></article></div><div class="overview-grid"><article class="panel"><div class="panel-heading"><div><h2>Prioridades territoriales</h2><p>Factores visibles para orientar la exploración</p></div><button class="subtle-link" data-go="radar">Abrir mapa <span set:html={ico(ArrowRight)}></span></button></div><div class="overview-zones">{zones.slice(0,3).map(z=><button class="overview-zone" data-zone={z.id}><span class={`zone-dot ${z.color}`}></span><span><strong>{z.name}</strong><small>{z.district}</small></span><span class="priority-number">{z.priority}</span><span set:html={ico(ArrowRight)}></span></button>)}</div></article><article class="panel next-panel"><div class="panel-heading"><div><h2>Trabajo en campo</h2><p>De la observación a una ficha útil</p></div><span set:html={ico(Camera)}></span></div><div class="next-illustration"><span set:html={ico(ScanSearch)}></span></div><p>Registra un negocio no mapeado y revisa señales visibles de una fachada antes de conversar con él.</p><button class="secondary" data-go="scanner">Abrir escáner <span set:html={ico(ArrowRight)}></span></button></article></div></section>
<section class="view" id="radar"><div class="page-heading"><div><p class="breadcrumb">Comercial / Radar territorial</p><h1>Radar territorial</h1><p>Compara potencial de microzonas y actividad de prospección por separado.</p></div><button class="secondary" id="reset-radar"><span set:html={ico(RefreshCw)}></span>Restablecer vista</button></div><div class="toolbar"><div class="filter-label"><span set:html={ico(SlidersHorizontal)}></span>Explorar por</div><label>Distrito<select id="district-filter"><option value="all">Todos los distritos</option><option value="Trujillo">Trujillo</option><option value="El Porvenir">El Porvenir</option><option value="La Esperanza">La Esperanza</option><option value="Florencia de Mora">Florencia de Mora</option></select></label><label>Prioridad<select id="priority-filter"><option value="0">Todas</option><option value="70">Alta (70+)</option><option value="60">Media y alta (60+)</option></select></label><span id="result-count" class="result-count">4 microzonas</span></div><div class="radar-grid"><div class="panel map-panel"><div class="panel-heading"><div><h2>Trujillo · zonas piloto</h2><p>Vista territorial esquemática</p></div><div class="legend"><span><i class="zone-dot high"></i>Alta</span><span><i class="zone-dot medium"></i>Media</span></div></div><div class="map" id="map"><div class="map-street street-a"></div><div class="map-street street-b"></div><div class="map-street street-c"></div><span class="map-label label-one">TRUJILLO</span><span class="map-label label-two">ÁREA PILOTO</span>{zones.map(z=><button class={`map-zone ${z.color}`} data-zone={z.id} style={`left:${z.x}%;top:${z.y}%`} aria-label={`Abrir ${z.name}`}><span set:html={ico(MapPin)}></span></button>)}</div><p class="map-footnote">Esquema para navegar escenarios. Las posiciones no representan coordenadas verificadas.</p></div><div class="panel zone-list"><div class="panel-heading"><div><h2>Microzonas</h2><p>Selecciona una para ver sus factores</p></div></div><div id="zone-list-items">{zones.map(z=><button class="zone-item" data-zone={z.id}><span class={`zone-dot ${z.color}`}></span><span><strong>{z.name}</strong><small>{z.district} · {z.visits} visitas de ejemplo</small></span><b>{z.priority}</b></button>)}</div></div></div><div class="panel explanation" id="zone-detail"><div class="explanation-header"><div><span class="section-label">MICROZONA SELECCIONADA</span><h2 id="zone-title">La Hermelinda</h2><p id="zone-reason">Alta concentración comercial y menor cobertura relativa de puntos de atención.</p></div><span class="score-circle" id="zone-score">84</span></div><div class="factor-grid"><div><span>Actividad comercial</span><strong id="factor-commerce">88 / 100</strong><div class="track"><i id="bar-commerce" style="width:88%"></i></div></div><div><span>Cobertura financiera relativa</span><strong id="factor-coverage">39 / 100</strong><div class="track"><i id="bar-coverage" style="width:39%"></i></div></div><div><span>Actividad de prospección</span><strong id="factor-visits">3 visitas</strong><p>Se muestra aparte del potencial territorial.</p></div></div><div class="explanation-actions"><button class="primary" data-go="scanner">Registrar hallazgo en campo <span set:html={ico(ArrowRight)}></span></button><button class="secondary" data-go="log">Ver bitácora</button></div></div></section>
<section class="view" id="scanner"><div class="page-heading"><div><p class="breadcrumb">Comercial / Escáner de campo</p><h1>Descubrimiento en campo</h1><p>Documenta un establecimiento no mapeado y prepara una ficha de observación.</p></div></div><div class="form-grid"><div class="panel"><div class="panel-heading"><div><h2>Nuevo hallazgo</h2><p>Completa los datos observables de la visita</p></div><span set:html={ico(Store)}></span></div><form id="scan-form"><label>Nombre o referencia del negocio<input id="business-name" required placeholder="Ej. Taller de la esquina"/></label><label>Microzona<select id="business-zone">{zones.map(z=><option value={z.id}>{z.name}</option>)}</select></label><label>Fotografía de fachada<input id="business-photo" type="file" accept="image/*"/></label><div class="photo-preview" id="photo-preview"><span set:html={ico(Camera)}></span><p>La imagen seleccionada aparecerá aquí</p></div><p class="helper">Evita incluir personas, placas o documentos en la fotografía.</p><button type="submit" class="primary full"><span set:html={ico(ScanSearch)}></span>Preparar observaciones</button></form></div><div class="panel observation-panel"><div class="panel-heading"><div><h2>Ficha contextual</h2><p>Revisa y corrige antes de registrar</p></div><span set:html={ico(Eye)}></span></div><div id="observation-empty" class="empty-state"><span set:html={ico(ScanSearch)}></span><strong>Sin hallazgo seleccionado</strong><p>Completa el formulario para preparar una ficha de observaciones.</p></div><div id="observation-content" hidden><div class="context-card"><span class="section-label">ESTABLECIMIENTO</span><h3 id="observed-name"></h3><p id="observed-zone"></p></div><label>Giro comercial aparente<select id="business-type"><option>Comercio minorista</option><option>Servicios</option><option>Alimentos</option><option>Otro / por confirmar</option></select></label><label>Señales visibles<textarea id="visible-signals" rows="3">Fachada comercial visible. Confirmar giro y actividad durante la visita.</textarea></label><div class="suggestion"><strong>Copiloto comercial</strong><p>Pregunta por las metas del negocio y explica las opciones disponibles sin asumir una necesidad financiera ni elegibilidad.</p></div><button class="primary full" id="create-visit">Registrar visita <span set:html={ico(ArrowRight)}></span></button></div></div></div></section>
<section class="view" id="log"><div class="page-heading"><div><p class="breadcrumb">Comercial / Bitácora</p><h1>Bitácora de prospección</h1><p>Registra resultados de campo sin alterar el potencial estructural de la zona.</p></div><button class="primary" data-go="scanner"><span set:html={ico(Plus)}></span>Nuevo hallazgo</button></div><div class="panel"><div class="panel-heading"><div><h2>Visitas del equipo</h2><p id="log-summary">Actividad registrada en este navegador</p></div></div><div id="visit-list"></div></div></section>
<section class="view" id="supervisor"><div class="page-heading"><div><p class="breadcrumb">Comercial / Supervisor</p><h1>Vista de supervisión</h1><p>Cobertura, actividad y resultados agregados para coordinar la exploración.</p></div></div><div class="metric-grid"><article class="metric"><span>Microzonas piloto</span><strong>04</strong><small>Potencial territorial independiente</small></article><article class="metric"><span>Visitas registradas</span><strong id="supervisor-visits">0</strong><small>Actualizadas desde la bitácora</small></article><article class="metric"><span>Con interés</span><strong id="supervisor-interest">0</strong><small>Resultados declarados por el equipo</small></article></div><div class="panel"><div class="panel-heading"><div><h2>Actividad por microzona</h2><p>Las visitas no recalculan el índice de potencial</p></div></div><div class="supervisor-list" id="supervisor-list"></div></div></section>
</main></div>
<script define:vars={{ zones }}>
const views=['overview','radar','scanner','log','supervisor'];let selectedZone=zones[0];let pendingBusiness=null;const storageKey='radarmype-visits-v1';let visits=[];try{visits=JSON.parse(localStorage.getItem(storageKey)||'[]');if(!Array.isArray(visits))visits=[]}catch{visits=[]}const $=s=>document.querySelector(s);const $$=s=>[...document.querySelectorAll(s)];function show(id){if(!views.includes(id))id='overview';$$('.view').forEach(v=>v.classList.toggle('active',v.id===id));$$('.nav').forEach(n=>n.classList.toggle('active',n.dataset.view===id));history.replaceState(null,'',`#${id}`);$('#sidebar').classList.remove('open');window.scrollTo(0,0);if(id==='log'||id==='supervisor')renderVisits()}$$('[data-view]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.view)));$$('[data-go]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.go)));$('#menu-button').addEventListener('click',()=>$('#sidebar').classList.toggle('open'));function selectZone(id){selectedZone=zones.find(z=>z.id===id)||zones[0];$('#zone-title').textContent=selectedZone.name;$('#zone-reason').textContent=selectedZone.reason;$('#zone-score').textContent=selectedZone.priority;$('#factor-commerce').textContent=selectedZone.commerce+' / 100';$('#factor-coverage').textContent=selectedZone.coverage+' / 100';$('#factor-visits').textContent=selectedZone.visits+' visitas';$('#bar-commerce').style.width=selectedZone.commerce+'%';$('#bar-coverage').style.width=selectedZone.coverage+'%';$('#business-zone').value=selectedZone.id;$$('[data-zone]').forEach(b=>b.classList.toggle('selected',b.dataset.zone===id));show('radar')}$$('[data-zone]').forEach(b=>b.addEventListener('click',()=>selectZone(b.dataset.zone)));function filterZones(){const district=$('#district-filter').value,threshold=Number($('#priority-filter').value);let count=0;$$('.zone-item,.map-zone').forEach(b=>{const z=zones.find(item=>item.id===b.dataset.zone);const visible=(district==='all'||z.district===district)&&z.priority>=threshold;b.hidden=!visible;if(visible&&b.classList.contains('zone-item'))count++});$('#result-count').textContent=count+' '+(count===1?'microzona':'microzonas');$('#zone-detail').hidden=count===0;let empty=$('#zone-empty');if(!count){if(!empty){empty=document.createElement('p');empty.id='zone-empty';empty.className='empty-inline';empty.textContent='No hay microzonas con estos filtros.';$('#zone-list-items').append(empty)}}else{empty?.remove();if(!$$('.zone-item:not([hidden])').some(b=>b.dataset.zone===selectedZone.id)){const first=$('.zone-item:not([hidden])');if(first)selectZone(first.dataset.zone)}}}$('#district-filter').addEventListener('change',filterZones);$('#priority-filter').addEventListener('change',filterZones);$('#reset-radar').addEventListener('click',()=>{$('#district-filter').value='all';$('#priority-filter').value='0';filterZones();selectZone(zones[0].id)});const file=$('#business-photo');file.addEventListener('change',()=>{const chosen=file.files?.[0];const preview=$('#photo-preview');preview.replaceChildren();if(chosen){const image=document.createElement('img');image.src=URL.createObjectURL(chosen);image.alt='Vista previa de la fachada seleccionada';preview.append(image)}else{preview.textContent='La imagen seleccionada aparecerá aquí'}});$('#scan-form').addEventListener('submit',e=>{e.preventDefault();const name=$('#business-name').value.trim();if(!name)return;pendingBusiness={name,zone:$('#business-zone').value};$('#observed-name').textContent=name;$('#observed-zone').textContent=zones.find(z=>z.id===pendingBusiness.zone).name;$('#observation-empty').hidden=true;$('#observation-content').hidden=false;$('#observation-content').scrollIntoView({behavior:'smooth',block:'nearest'})});$('#create-visit').addEventListener('click',()=>{if(!pendingBusiness)return;const id=Date.now();visits.unshift({id,name:pendingBusiness.name,zone:pendingBusiness.zone,type:$('#business-type').value,signals:$('#visible-signals').value.trim(),status:'Pendiente',date:new Date().toLocaleDateString('es-PE')});localStorage.setItem(storageKey,JSON.stringify(visits));pendingBusiness=null;$('#scan-form').reset();$('#photo-preview').textContent='La imagen seleccionada aparecerá aquí';$('#observation-empty').hidden=false;$('#observation-content').hidden=true;show('log')});function renderVisits(){$('#visits-count').textContent=visits.length;$('#supervisor-visits').textContent=visits.length;$('#supervisor-interest').textContent=visits.filter(v=>v.status==='Interesado').length;$('#log-summary').textContent=visits.length+' visitas registradas en este navegador';const list=$('#visit-list');list.replaceChildren();if(!visits.length){const empty=document.createElement('div');empty.className='empty-state';empty.textContent='Aún no hay visitas registradas. Abre el escáner para añadir un hallazgo.';list.append(empty)}visits.forEach(v=>{const row=document.createElement('div');row.className='visit-row';const info=document.createElement('div');const name=document.createElement('strong');name.textContent=v.name;const meta=document.createElement('small');meta.textContent=`${zones.find(z=>z.id===v.zone)?.name||v.zone} · ${v.type} · ${v.date}`;info.append(name,meta);const select=document.createElement('select');select.setAttribute('aria-label',`Resultado de visita: ${v.name}`);['Pendiente','Interesado','No interesado','Atendido por otra entidad'].forEach(status=>{const option=document.createElement('option');option.value=status;option.textContent=status;select.append(option)});select.value=v.status;select.addEventListener('change',()=>{v.status=select.value;localStorage.setItem(storageKey,JSON.stringify(visits));renderVisits()});row.append(info,select);list.append(row)});const supervisor=$('#supervisor-list');supervisor.replaceChildren();zones.forEach(z=>{const row=document.createElement('div');row.className='supervisor-row';const info=document.createElement('div');const title=document.createElement('strong');title.textContent=z.name;const meta=document.createElement('small');meta.textContent=`Potencial ${z.priority}/100 · ${z.district}`;info.append(title,meta);const count=document.createElement('span');count.textContent=visits.filter(v=>v.zone===z.id).length+' visitas registradas';row.append(info,count);supervisor.append(row)})}renderVisits();if(views.includes(location.hash.slice(1)))show(location.hash.slice(1));
</script>
</body></html>
